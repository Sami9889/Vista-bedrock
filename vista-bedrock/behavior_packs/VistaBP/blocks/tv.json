{
  "format_version": "1.20.0",
  "minecraft:block": {
    "description": {
      "identifier": "vista:tv",
      "category": "interactive",
      "properties": {
        "minecraft:cardinal_direction": ["north", "south", "east", "west"],
        "minecraft:display_layer": ["off", "on"],
        "minecraft:channel": ["none","blue","red","green","yellow","purple","orange","cyan","pink","white","black","gray","lime","light_blue","magenta","hollow"]
      }
    },
    "components": {
      "minecraft:geometry": "geometry.tv",
      "minecraft:collision_box": { "origin": [-8, 0, -8], "size": [16, 12, 4] },
      "minecraft:selection_box": { "origin": [-8, 0, -8], "size": [16, 12, 4] },
      "minecraft:destructible_by_mining": { "value": 1.5 },
      "minecraft:destructible_by_explosion": { "value": 5 },
      "minecraft:flammable": { "catch_chance_modifier": 5, "destroy_chance_modifier": 20 },
      "minecraft:map_color": { "color": [0.2, 0.2, 0.25] },
      "minecraft:on_player_placing": { "event": "vista:on_placed" },
      "minecraft:on_player_destroyed": { "event": "vista:on_destroyed" },
      "minecraft:on_interact": { "event": "vista:on_interact" },
      "minecraft:redstone": { "redstone_signal": true },
      "minecraft:material_instances": {
        "up": { "texture": "tv", "render_method": "opaque" },
        "down": { "texture": "tv", "render_method": "opaque" },
        "north": { "texture": "tv", "render_method": "opaque" },
        "south": { "texture": "tv", "render_method": "opaque" },
        "east": { "texture": "tv", "render_method": "opaque" },
        "west": { "texture": "tv", "render_method": "opaque" }
      },
      "minecraft:light_emission": { "light_level": 3 }
    },
    "events": {
      "vista:on_placed": {
        "set_block_property": { "minecraft:channel": "none", "minecraft:display_layer": "off" },
        "run_command": { "command": ["tag @s add vista_tv"] }
      },
      "vista:on_destroyed": {
        "run_command": { "command": ["tag @s remove vista_tv"] }
      },
      "vista:on_interact": {
        "sequence": [
          { "filter": "vista:has_cassette", "run_command": { "command": ["vista tv_insert_cassette"] }},
          { "filter": "vista:has_picture_tape", "run_command": { "command": ["vista tv_insert_picture_tape"] }},
          { "filter": "vista:has_hollow_cassette", "run_command": { "command": ["vista tv_insert_hollow"] }},
          { "filter": "vista:has_nothing", "run_command": { "command": ["tellraw @s {\"rawtext\":[{\"text\":\"§7Insert a cassette, picture tape or hollow cassette.\"}]}" ] }}
        ]
      }
    },
    "permutations": [
      { "condition": "query.block_property('minecraft:display_layer') == 'on'", "components": {
        "minecraft:material_instances": {
          "north": { "texture": "tv", "render_method": "double_sided", "face_uv": [12, 0, 16, 16] }
        },
        "minecraft:light_emission": { "light_level": 10 }
      }}
    ]
  }
}
